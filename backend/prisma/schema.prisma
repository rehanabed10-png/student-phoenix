// ==========================================
// Student Phoenix — Prisma Schema
// Phase 1.5 — Architecture Lock: Database Preparation (Supabase PostgreSQL)
// ==========================================
//
// NOTE:
// - Provider is PostgreSQL.
// - Database connection URL is loaded from DATABASE_URL (transaction pooler).
// - Direct connection URL is loaded from DIRECT_URL (session pooler for migrations).
// - Entities (Users, Roles, Sessions, etc.) will be defined strictly
//   phase-by-phase starting with Authentication & Users (Phase 2).
// - No speculative models or premature migrations are included here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
