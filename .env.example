# ==========================================
# Student Phoenix — Environment Template
# Phase 1.5 Architecture Lock & Phase 2 Auth
# ==========================================

# ------------------------------------------
# BACKEND CONFIGURATION
# ------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------
VITE_API_URL=http://localhost:3000

# ------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL / Supabase + Prisma)
# ------------------------------------------
# Transaction pooler (for queries in serverless/pooled environments):
DATABASE_URL="postgresql://phoenix_user:phoenix_password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler / Direct connection (for schema migrations & DDL):
DIRECT_URL="postgresql://phoenix_user:phoenix_password@aws-0-region.pooler.supabase.com:5432/postgres"

# ------------------------------------------
# AUTH CONFIGURATION (Phase 2.3)
# ------------------------------------------
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
