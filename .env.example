# ==========================================
# Student Phoenix — Environment Template
# Phase 1.5 Architecture Lock
# ==========================================

# ------------------------------------------
# BACKEND CONFIGURATION
# ------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------
VITE_API_URL=http://localhost:3000

# ------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL + Prisma)
# ------------------------------------------
# Connection string format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://phoenix_user:phoenix_password@localhost:5432/student_phoenix?schema=public"

# ------------------------------------------
# AUTH CONFIGURATION (Preparation for Phase 2)
# ------------------------------------------
JWT_ACCESS_SECRET="your-jwt-access-secret-placeholder"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-placeholder"
JWT_REFRESH_EXPIRATION="7d"
